<Window x:Class="Karaoke.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Karaoke.Desktop.Controls"
        xmlns:vm="clr-namespace:Karaoke.Desktop.ViewModels"
        xmlns:local="clr-namespace:Karaoke.Desktop"
        mc:Ignorable="d"
        Title="Karaoke Profesional - Modo Comercial Windows (C# WPF)" 
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#070812">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Custom button styles for commercial neon look -->
        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00FFFF"/>
                                <Setter Property="Foreground" Value="#121218"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00CCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
            <Setter Property="Background" Value="#FFC000"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEA00"/>
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0C0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavMenuButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
            <Setter Property="Background" Value="#182040"/>
            <Setter Property="Foreground" Value="#00A8FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="BasePageButtonStyle" TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
            <Setter Property="Background" Value="#16182C"/>
            <Setter Property="BorderBrush" Value="#2E3458"/>
            <Setter Property="Foreground" Value="#CCDDEE"/>
        </Style>

        <Style x:Key="PageButton1Style" TargetType="Button" BasedOn="{StaticResource BasePageButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPageBtn1Active}" Value="True">
                    <Setter Property="Background" Value="#0088FF"/>
                    <Setter Property="BorderBrush" Value="#44B8FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageButton2Style" TargetType="Button" BasedOn="{StaticResource BasePageButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPageBtn2Active}" Value="True">
                    <Setter Property="Background" Value="#0088FF"/>
                    <Setter Property="BorderBrush" Value="#44B8FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageButton3Style" TargetType="Button" BasedOn="{StaticResource BasePageButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPageBtn3Active}" Value="True">
                    <Setter Property="Background" Value="#0088FF"/>
                    <Setter Property="BorderBrush" Value="#44B8FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageButton4Style" TargetType="Button" BasedOn="{StaticResource BasePageButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPageBtn4Active}" Value="True">
                    <Setter Property="Background" Value="#0088FF"/>
                    <Setter Property="BorderBrush" Value="#44B8FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageButton5Style" TargetType="Button" BasedOn="{StaticResource BasePageButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPageBtn5Active}" Value="True">
                    <Setter Property="Background" Value="#0088FF"/>
                    <Setter Property="BorderBrush" Value="#44B8FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <!-- REPRODUCTOR MAESTRO DE VIDEO DE FONDO -->
        <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="False" RenderOptions.BitmapScalingMode="LowQuality" Stretch="UniformToFill" Grid.ColumnSpan="3">
            <MediaElement.Style>
                <Style TargetType="MediaElement">
                    <Setter Property="Panel.ZIndex" Value="-1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVideoPopupOpen}" Value="True">
                            <Setter Property="Panel.ZIndex" Value="9998"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MediaElement.Style>
        </MediaElement>

        <!-- FONDO DE LA INTERFAZ -->
        <Rectangle Fill="#070812" Grid.ColumnSpan="3" Panel.ZIndex="0" />

        <Grid Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="250"/>
                <ColumnDefinition x:Name="CenterColumn" Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="400"/>
            </Grid.ColumnDefinitions>
        <!-- SECCIÓN 1: LADO IZQUIERDO (Navegación Lateral Tipo Karafun Pro) -->
        <Border x:Name="SidebarBorder" Grid.Column="0" BorderBrush="#1C203C" BorderThickness="0,0,1,0" Padding="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#080A18" Offset="0"/>
                    <GradientStop Color="#10142E" Offset="0.5"/>
                    <GradientStop Color="#070814" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Minimalista y Elegante -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24" Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="Transparent" Margin="0,0,12,0" BorderThickness="0" ClipToBounds="True">
                        <Image Source="{Binding LogoImagePath}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PLAZA 28 KARAOKE" FontSize="16" FontWeight="Black" Foreground="#E0FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menú Vertical de Opciones (Estilo Imagen 2) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Exploración -->
                        <Button Content="🔍 Búsqueda Rápida" Command="{Binding SelectNavCommand}" CommandParameter="Search" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="Search">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🎲 Música Aleatoria" Command="{Binding SelectNavCommand}" CommandParameter="Discover" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="Discover">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📁 Playlists" Command="{Binding SelectNavCommand}" CommandParameter="Playlists" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="Playlists">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🏆 Top Más Cantadas" Command="{Binding SelectNavCommand}" CommandParameter="TopPlayed" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="TopPlayed">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🎵 Todos los Géneros" Command="{Binding SelectNavCommand}" CommandParameter="AllGenres" HorizontalContentAlignment="Left" Margin="0,0,0,18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="AllGenres">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Mi Música -->
                        <TextBlock Text="MI MÚSICA" FontSize="11" FontWeight="Black" Foreground="#606688" Margin="8,0,0,8"/>
                        <Button Content="💙 Favoritos" Command="{Binding SelectNavCommand}" CommandParameter="Favorites" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="Favorites">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🕒 Historial de Sesión" Command="{Binding SelectNavCommand}" CommandParameter="History" HorizontalContentAlignment="Left" Margin="0,0,0,18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavMenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTab}" Value="History">
                                            <Setter Property="Background" Value="#182040"/>
                                            <Setter Property="Foreground" Value="#00A8FF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Mis Playlists y Archivos -->
                        <TextBlock Text="MIS ARCHIVOS &amp; VIP" FontSize="11" FontWeight="Black" Foreground="#606688" Margin="8,0,0,8"/>
                        
                        <Button Command="{Binding CreatePlaylistCommand}" Margin="0,0,0,12" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Grid>
                                <Rectangle Stroke="#303550" StrokeThickness="1.5" StrokeDashArray="4 4" RadiusX="6" RadiusY="6"/>
                                <StackPanel Orientation="Horizontal" Margin="14,12">
                                    <TextBlock Text="➕" Foreground="#00A8FF" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Crear una Playlist..." Foreground="#00A8FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        
                        <Button Content="📁 Agregar MP3 Local" Command="{Binding SelectMp3FileCommand}" HorizontalContentAlignment="Left" Style="{StaticResource NavMenuButtonStyle}" Foreground="#00FFFF" Margin="0,0,0,6"/>
                        <Button Content="🖼️ Cambiar Fondo (🔒)" Command="{Binding SelectBackgroundImageCommand}" HorizontalContentAlignment="Left" Style="{StaticResource NavMenuButtonStyle}" Foreground="#FFD700" ToolTip="Requiere clave admin 123" Margin="0,0,0,6"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie del menú -->
                <Border Grid.Row="2" Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="🎵 300+ Canciones en HD" FontSize="11" FontWeight="Bold" Foreground="#88AACC"/>
                        <TextBlock Text="PRO" FontSize="11" FontWeight="Black" Foreground="#00FFFF" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- SECCIÓN 2: CENTRO (Contenido Principal - Playlists & Catálogo) -->
        <Grid x:Name="TransportBorder" Grid.Column="1" Background="#0C0E1C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera con Título, Búsqueda y Filtros -->
                <RowDefinition Height="*"/>    <!-- Vistas: Grid de Tarjetas de Playlists o Tabla de Canciones -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- CABECERA DEL CENTRO -->
            <Border Grid.Row="0" Background="#101224" BorderBrush="#1C2038" BorderThickness="0,0,0,1" Padding="24,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Título y Volver -->
                        <RowDefinition Height="Auto"/> <!-- 1: Barra de búsqueda -->
                        <RowDefinition Height="Auto"/> <!-- 2: Filtros de audio debajo de la búsqueda -->
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Título Principal -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CurrentViewTitle}" FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Fila 1: Buscador en vivo de canciones (Ancho Completo para no comprimirse) -->
                    <Border Grid.Row="1" Background="#14182C" CornerRadius="12" BorderBrush="#2A3050" BorderThickness="1.5" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>    <!-- 0: TextBox (sin lupa al inicio) -->
                                <ColumnDefinition Width="Auto"/> <!-- 1: Pegar Icono -->
                                <ColumnDefinition Width="Auto"/> <!-- 2: Limpiar Icono -->
                                <ColumnDefinition Width="Auto"/> <!-- 3: Botón Buscar -->
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Padding="16,12,8,12"/>
                            <Button Grid.Column="1" Content="📋" Command="{Binding PasteAndSearchCommand}" 
                                    Style="{StaticResource NeonButtonStyle}" Padding="12,6" Margin="0,6,4,6" FontSize="15" ToolTip="Pegar desde portapapeles y buscar"/>
                            <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}" 
                                    Style="{StaticResource NeonButtonStyle}" Padding="12,6" Margin="0,6,6,6" FontSize="15" ToolTip="Limpiar búsqueda"/>
                            <Button Grid.Column="3" Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource NeonButtonStyle}" Margin="0,6,6,6"/>
                        </Grid>
                    </Border>

                    <!-- Fila 2: Filtros de Pistas (Con Voz vs Instrumental) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FILTROS DE AUDIO:" FontSize="11" FontWeight="Black" Foreground="#606688" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="🎤 Con Voz + Letra Oficial" Command="{Binding SelectVocalFilterCommand}" 
                                Padding="12,7" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" ToolTip="Canciones originales cantadas por el artista">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                    <Setter Property="Background" Value="#151728"/>
                                    <Setter Property="BorderBrush" Value="#2C3252"/>
                                    <Setter Property="Foreground" Value="#AABBCC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVocalFilter}" Value="True">
                                            <Setter Property="Background" Value="#0088FF"/>
                                            <Setter Property="BorderBrush" Value="#44B8FF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🎹 Instrumental + Letra (Karaoke Puro)" Command="{Binding SelectInstrumentalFilterCommand}"
                                Padding="12,7" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,16,0" ToolTip="Pistas instrumentales sin voz para cantar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                    <Setter Property="Background" Value="#151728"/>
                                    <Setter Property="BorderBrush" Value="#2C3252"/>
                                    <Setter Property="Foreground" Value="#AABBCC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstrumentalFilter}" Value="True">
                                            <Setter Property="Background" Value="#00FFFF"/>
                                            <Setter Property="BorderBrush" Value="#88FFFF"/>
                                            <Setter Property="Foreground" Value="#101224"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VISTAS PRINCIPALES (Grid de Playlists o Tabla de Canciones) -->
            <Grid Grid.Row="1" Margin="24">
                <!-- VISTA 1: GRID DE PLAYLISTS (Tarjetas con imágenes AI como Imagen 3) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsPlaylistsView, Converter={StaticResource BoolToVis}}"
                              HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Playlists}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Tarjeta de Playlist -->
                                <Border Width="245" Height="285" Margin="14" CornerRadius="18" Background="#16182C" BorderBrush="#2E3458" BorderThickness="1.5" Cursor="Hand" ClipToBounds="True">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectPlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="6" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Imagen o Fondo de la Playlist -->
                                        <Border Grid.Row="0" Background="#1F1B3C" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                                                <!-- Overlay para legibilidad -->
                                                <Border Background="#15000000"/>
                                                
                                                <!-- Botones de Control (Editar/Eliminar) -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                    <Button Content="✏️" Command="{Binding DataContext.EditPlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Background="#A0000000" Foreground="White" BorderThickness="0" FontSize="14" Padding="6,4" Margin="0,0,6,0" Cursor="Hand" ToolTip="Editar Playlist">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="🗑️" Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Background="#A0440000" Foreground="#FF4444" BorderThickness="0" FontSize="14" Padding="6,4" Cursor="Hand" ToolTip="Eliminar Playlist">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Título de la Playlist -->
                                        <StackPanel Grid.Row="1" Margin="14,10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#88AACC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- VISTA 2: TABLA DE CANCIONES (50 éxitos por página, sin solapamiento) -->
                <DockPanel Visibility="{Binding IsPlaylistsView, Converter={StaticResource InvBoolToVis}}" LastChildFill="True">
                    <!-- Cabecera de la tabla de canciones (Dock Top) -->
                    <Border DockPanel.Dock="Top" Background="#16182C" CornerRadius="10,10,0,0" Padding="16,13" BorderBrush="#2D3256" BorderThickness="1,1,1,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="PORTADA" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="CANCIÓN / ARTISTA" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="3" Text="GÉNERO" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="5" Text="FAV" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="TOP 🔥" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="7" Text="ACCIÓN" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Barra Inferior de Paginación (Dock Bottom, Siempre Visible, Sin Solapar) -->
                    <Border DockPanel.Dock="Bottom" Background="#181432" CornerRadius="0,0,10,10" Padding="18,12" BorderBrush="#0088FF" BorderThickness="1,0,1,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Botón Anterior con Icono Mejorado -->
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="PREV" Style="{StaticResource NeonButtonStyle}" Padding="16,7" Margin="0,0,12,0" Cursor="Hand" Visibility="{Binding IsMultiPage, Converter={StaticResource BoolToVis}}" ToolTip="Página anterior">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Anterior" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Botones Dinámicos de Página -->
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="{Binding PageBtn1Val}" Content="{Binding PageBtn1Val}" Style="{StaticResource PageButton1Style}" Width="42" Height="34" FontSize="13" FontWeight="Bold" Margin="4,0" Cursor="Hand" Visibility="{Binding IsPageBtn1Visible, Converter={StaticResource BoolToVis}}"/>
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="{Binding PageBtn2Val}" Content="{Binding PageBtn2Val}" Style="{StaticResource PageButton2Style}" Width="42" Height="34" FontSize="13" FontWeight="Bold" Margin="4,0" Cursor="Hand" Visibility="{Binding IsPageBtn2Visible, Converter={StaticResource BoolToVis}}"/>
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="{Binding PageBtn3Val}" Content="{Binding PageBtn3Val}" Style="{StaticResource PageButton3Style}" Width="42" Height="34" FontSize="13" FontWeight="Bold" Margin="4,0" Cursor="Hand" Visibility="{Binding IsPageBtn3Visible, Converter={StaticResource BoolToVis}}"/>
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="{Binding PageBtn4Val}" Content="{Binding PageBtn4Val}" Style="{StaticResource PageButton4Style}" Width="42" Height="34" FontSize="13" FontWeight="Bold" Margin="4,0" Cursor="Hand" Visibility="{Binding IsPageBtn4Visible, Converter={StaticResource BoolToVis}}"/>
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="{Binding PageBtn5Val}" Content="{Binding PageBtn5Val}" Style="{StaticResource PageButton5Style}" Width="42" Height="34" FontSize="13" FontWeight="Bold" Margin="4,0" Cursor="Hand" Visibility="{Binding IsPageBtn5Visible, Converter={StaticResource BoolToVis}}"/>
                            
                            <!-- Botón Siguiente con Icono Mejorado -->
                            <Button Command="{Binding SelectPageCommand}" CommandParameter="NEXT" Style="{StaticResource GoldButtonStyle}" Padding="18,7" Margin="12,0,0,0" Cursor="Hand" Visibility="{Binding IsMultiPage, Converter={StaticResource BoolToVis}}" ToolTip="Página siguiente">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Siguiente" FontSize="13" FontWeight="Bold" Foreground="#0A0818" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Path Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Fill="#0A0818" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Lista / Tabla de Canciones (Como último elemento del DockPanel, llena el espacio restante) -->
                    <ListBox ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" 
                             Background="#0E1020" BorderBrush="#242846" BorderThickness="1,0,1,0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,11" BorderBrush="#181B34" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Número de Pista (1, 2, 3...) -->
                                        <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" FontSize="13" FontWeight="SemiBold" Foreground="#7C8AAB" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Portada del Artista / Álbum -->
                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="6" Background="#221A38" BorderBrush="#3D3366" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Título y Artista -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="🎤 " FontSize="12" Foreground="#88CCFF" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="12.5" FontWeight="SemiBold" Foreground="#88CCFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Género -->
                                        <TextBlock Grid.Column="3" Text="{Binding Category}" FontSize="12.5" FontWeight="Medium" Foreground="#8C9EFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Duración -->
                                        <TextBlock Grid.Column="4" Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#C8D2E6" VerticalAlignment="Center"/>

                                        <!-- Botón Favorito (Sin emoji negro, outline blanco limpio y corazón rojo brillante) -->
                                        <Button Grid.Column="5" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" ToolTip="Marcar o desmarcar como favorito">
                                            <TextBlock FontSize="20" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="♡"/>
                                                        <Setter Property="Foreground" Value="#E0E8FF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="💙"/>
                                                                <Setter Property="Foreground" Value="#00A8FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Reproducciones / Top -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔥 " FontSize="12" Foreground="#FFD700"/>
                                            <TextBlock Text="{Binding PlayCount}" FontSize="13" FontWeight="Bold" Foreground="#FFD700"/>
                                        </StackPanel>

                                        <!-- Botón Play -->
                                        <Button Grid.Column="7" Content="▶ Play" 
                                                Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource NeonButtonStyle}" Padding="8,5" FontSize="11" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1A1D36"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252048"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- STATUS BAR EN CENTRO INFERIOR -->
            <Border x:Name="StatusBorder" Grid.Row="2" Background="#101224" Padding="24,8" BorderBrush="#1C2038" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#88AACC"/>
                    <TextBlock Text="⚡ Karaoke Pro Cloud Engine" FontSize="11" Foreground="#556688" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- SECCIÓN 3: LADO DERECHO (Escenario Pequeño & Reproductor y Cola como Imagen 5) -->
        <Border x:Name="StageBorder" Grid.Column="2" Background="#080812" BorderBrush="#1C2036" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Cabecera y Botón Ventana TV -->
                    <RowDefinition Height="230"/>  <!-- Mini-Escenario Karaoke (Pequeño) -->
                    <RowDefinition Height="Auto"/> <!-- Transporte Reproductor -->
                    <RowDefinition Height="*"/>    <!-- Cola de Reproducción (Queue) -->
                </Grid.RowDefinitions>

                <!-- 1. CABECERA DERECHA -->
                <Grid Grid.Row="0" Margin="18,16,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔵 EN VIVO" FontSize="12" FontWeight="Black" Foreground="#00A8FF" Margin="0,0,8,0"/>
                        <TextBlock Text="• ESCENARIO TV" FontSize="12" FontWeight="Bold" Foreground="#88AACC"/>
                    </StackPanel>
                    
                    <!-- Solo Botón Ventana Emergente TV (Quitamos el zoom como se pidió) -->
                    <Button x:Name="BtnPopUp" Grid.Column="1" Click="OnOpenPopUpStageClick"
                            Style="{StaticResource GoldButtonStyle}" Padding="10,6" ToolTip="Abrir en TV o Proyector secundario (Presiona F11 allá para maximizar)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔲 VENTANA EMERGENTE (TV)" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 2. MINI-ESCENARIO DE KARAOKE (EN FORMA PEQUEÑO COMO IMAGEN 5) -->
                <Border Grid.Row="1" Margin="18,4,18,16" CornerRadius="14" ClipToBounds="True" BorderBrush="#252A4A" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="8" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Fondo Visual (Imagen o Color) -->
                        <Grid Opacity="0.65">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2A0845" Offset="0"/>
                                        <GradientStop Color="#1B1238" Offset="0.5"/>
                                        <GradientStop Color="#080814" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" Opacity="0.75"/>
                        </Grid>

                        <!-- Control de Letras Sincronizadas (En Dos Líneas, Estilo Profesional) -->
                        <Grid>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Línea 1: Letra Activa (Iluminación dorada palabra por palabra) -->
                                    <controls:KaraokeLyricsControl 
                                        Text="{Binding CurrentLyricText}" 
                                        Progress="{Binding LyricProgress}" 
                                        HorizontalAlignment="Center"/>
                                    
                                    <!-- Línea 2: Siguiente Letra (En blanco resplandeciente, justo debajo como bloque de dos líneas) -->
                                    <TextBlock Text="{Binding NextLyricText}" 
                                               FontSize="34" 
                                               FontWeight="ExtraBold" 
                                               Foreground="#FFFFFF" 
                                               Opacity="0.85"
                                               MaxWidth="1100"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center" 
                                               Margin="0,14,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="1.0"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Viewbox>
                        </Grid>

                        <!-- Indicador de En Vivo -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#900066CC" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="LIVE LYRICS" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. REPRODUCTOR Y CONTROLES (Como Imagen 5) -->
                <Border Grid.Row="2" Background="#121424" Margin="18,0,18,16" CornerRadius="14" Padding="16,14" BorderBrush="#222640" BorderThickness="1">
                    <StackPanel>
                        <!-- Título de canción activa -->
                        <TextBlock Text="{Binding SelectedSong.DisplayName, FallbackValue='Ninguna pista reproduciendo'}" 
                                   FontSize="15" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedSong.Artist, FallbackValue='Plaza 28 Audio'}" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                        <!-- Barra de tiempo (Slider) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider x:Name="SeekSlider" Grid.Row="0" Minimum="0" Maximum="{Binding TotalDurationSeconds}" 
                                    Value="{Binding CurrentPositionSeconds, Mode=OneWay}" 
                                    Thumb.DragCompleted="OnSeekSliderDragCompleted"/>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentPositionSeconds, StringFormat='{}{0:00}:{1:00}'}" FontSize="11" Foreground="#8899B0" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11" FontWeight="Bold" Foreground="#00FFFF" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- Botones de Transporte y Control Estilo YouTube / VIP -->
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Fila 0: Los 4 iconos principales + Stop -->
                                <RowDefinition Height="Auto"/> <!-- Fila 1: Control de volumen en la parte baja -->
                            </Grid.RowDefinitions>

                            <!-- Fila 0: 1. Anterior | 2. Play/Pause Toggle | 3. Siguiente | 4. Infinito | 5. Stop -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                                <!-- 1. Anterior (MDI: SkipPrevious) -->
                                <Button Command="{Binding PreviousSongCommand}" Width="46" Height="46" Style="{StaticResource NeonButtonStyle}" Margin="0,0,12,0" ToolTip="Canción anterior (Flecha Izquierda)">
                                    <Path Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18"/>
                                </Button>

                                <!-- 2. Play / Pause Unificado (Toggle) -->
                                <Button Command="{Binding TogglePlayPauseCommand}" Width="60" Height="60" Style="{StaticResource GoldButtonStyle}" Margin="0,0,12,0" ToolTip="Reproducir / Pausar (Espacio)">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                                    </Button.Effect>
                                    <Grid>
                                        <!-- MDI: Play (Muestra cuando NO está reproduciendo) -->
                                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              Stretch="Uniform" Width="24" Height="24" Margin="3,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}"/>
                                        <!-- MDI: Pause (Muestra cuando SÍ está reproduciendo) -->
                                        <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              Stretch="Uniform" Width="22" Height="22"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>

                                <!-- 3. Siguiente (MDI: SkipNext) -->
                                <Button Command="{Binding NextSongCommand}" Width="46" Height="46" Style="{StaticResource NeonButtonStyle}" Margin="0,0,12,0" ToolTip="Siguiente canción (Flecha Derecha)">
                                    <Path Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18"/>
                                </Button>

                                <!-- 4. Infinito / Replay (Despues del desplazar cancion) -->
                                <Button Command="{Binding ToggleLoopCommand}" Width="46" Height="46" ToolTip="Replay Infinito (Estilo YouTube Loop)" Margin="0,0,12,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                            <Setter Property="Foreground" Value="#7788AA"/>
                                            <Setter Property="BorderBrush" Value="#333850"/>
                                            <Setter Property="Background" Value="#161824"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLooping}" Value="True">
                                                    <Setter Property="Background" Value="#00FFFF"/>
                                                    <Setter Property="BorderBrush" Value="#00FFFF"/>
                                                    <Setter Property="Foreground" Value="#101220"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#00FFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <!-- MDI: Repeat -->
                                    <Path Data="M17,17H7V14L3,18L7,22V19H19V11H17M7,7H17V10L21,6L17,2V5H5V13H7V7Z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="20" Height="20"/>
                                </Button>

                                <!-- 5. Stop -->
                                <Button Command="{Binding StopCommand}" Width="46" Height="46" Style="{StaticResource NeonButtonStyle}" ToolTip="Detener y reiniciar letra">
                                    <Path Data="M18,18H6V6H18V18Z" Fill="#00A8FF" Stretch="Uniform" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>

                            <!-- Fila 1: Control de volumen en la parte baja de los iconos -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,6">
                                <Button Command="{Binding ToggleMuteCommand}" Width="36" Height="36" ToolTip="Silenciar / Activar audio" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                            <Setter Property="Foreground" Value="#00FFFF"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                    <Setter Property="BorderBrush" Value="#FF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <!-- MDI: VolumeHigh -->
                                        <Path Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18"
                                              Visibility="{Binding IsMuted, Converter={StaticResource InvBoolToVis}}"/>
                                        <!-- MDI: VolumeOff -->
                                        <Path Data="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.45 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18"
                                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>

                                <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="160" VerticalAlignment="Center" ToolTip="Volumen del audio"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. COLA DE REPRODUCCIÓN (QUEUE COMO IMAGEN 5) -->
                <Grid Grid.Row="3" Margin="18,0,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" BorderBrush="#1C2036" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="Video de Reproducción" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleSubtitlesCommand}" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Activar / Desactivar subtítulos de letras sobre el video">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SubtitleStatusText}" FontSize="11" FontWeight="Bold" Foreground="#00FFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleVideoPopupCommand}" Content="🗗" FontSize="14" Foreground="#00A8FF" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" ToolTip="Ventana Emergente (Ver Video en Grande)" Cursor="Hand"/>
                                <TextBlock Text="{Binding Songs.Count, StringFormat='{}{0} pistas disponibles'}" FontSize="11" Foreground="#667799" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- Caja de cola limpia / Video Player -->
                    <Border Grid.Row="1" Background="#0C0E1C" CornerRadius="10" BorderBrush="#1C2036" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎤 El Escenario está Listo" FontSize="14" FontWeight="Bold" Foreground="#88AACC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Haz clic en cualquier canción de la lista del centro para cantarla." FontSize="12" Foreground="#667799" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Rectangle>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                    <Condition Binding="{Binding IsVideoPopupOpen}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                                <Rectangle.Fill>
                                    <VisualBrush Visual="{Binding ElementName=AudioPlayer}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Subtítulos / Letras sobre el video miniatura cuando está ACTIVADO -->
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,14" 
                                        Visibility="{Binding IsSubtitlesEnabled, Converter={StaticResource BoolToVis}}" 
                                        IsHitTestVisible="False">
                                <controls:KaraokeLyricsControl 
                                    Text="{Binding CurrentLyricText}" 
                                    Progress="{Binding LyricProgress}" 
                                    HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NextLyricText}" 
                                           FontSize="16" 
                                           FontWeight="ExtraBold" 
                                           Foreground="#FFFFFF" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center" 
                                           Margin="0,4,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="1.0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        </Grid> <!-- Cierre del Grid Panel.ZIndex="10" -->

        <!-- PANTALLA COMPLETA CONTROLES OVERLAY -->
        <Grid Grid.ColumnSpan="3" Visibility="{Binding IsVideoPopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="9999" Background="Transparent">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30">
                <TextBlock Text="EN VIVO" FontSize="14" FontWeight="Black" Foreground="#00A8FF"/>
                <TextBlock Text="{Binding SelectedSong.DisplayName, FallbackValue='Plaza 28 Karaoke'}" FontSize="28" FontWeight="Black" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- Letras de Karaoke Sincronizadas en la Pantalla Completa TV (Dos Líneas) -->
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="40,30" HorizontalAlignment="Center" VerticalAlignment="Center" 
                     Visibility="{Binding IsSubtitlesEnabled, Converter={StaticResource BoolToVis}}"
                     IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:KaraokeLyricsControl 
                        Text="{Binding CurrentLyricText}" 
                        Progress="{Binding LyricProgress}" 
                        HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding NextLyricText}" 
                               FontSize="46" 
                               FontWeight="ExtraBold" 
                               Foreground="#FFFFFF" 
                               Opacity="0.85"
                               MaxWidth="1600"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               Margin="0,18,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="5" Opacity="1.0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
            
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="30">
                <!-- Botón Subtítulos ON/OFF en Pantalla Completa -->
                <Button Command="{Binding ToggleSubtitlesCommand}" Margin="0,0,12,0" Background="#A00C0E1C" BorderBrush="#00FFFF" BorderThickness="1.5" Padding="14,10" Cursor="Hand" ToolTip="Activar / Desactivar subtítulos de letras sobre el video">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SubtitleStatusText}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Botón Cerrar Pantalla Completa -->
                <Button Command="{Binding ToggleVideoPopupCommand}" Background="#A00C0E1C" BorderBrush="#0088FF" BorderThickness="1.5" Padding="14,10" Cursor="Hand" ToolTip="Salir de Pantalla Completa (F11 / ESC)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✖" FontSize="14" Foreground="#00A8FF" FontWeight="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cerrar (F11 / ESC)" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
