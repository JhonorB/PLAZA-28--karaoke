<Window x:Class="Karaoke.Desktop.Views.PlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist" Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Estilos de botones básicos para mantener la estética neón -->
        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0088FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44B8FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44B8FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
            <Setter Property="Background" Value="#1A1C30"/>
            <Setter Property="BorderBrush" Value="#2E3458"/>
            <Setter Property="Foreground" Value="#88AACC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252A4A"/>
                    <Setter Property="BorderBrush" Value="#88AACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#101224"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E3458"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0C0E1C" BorderBrush="#252040" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="🎵 Detalles de Playlist" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="N O M B R E" Foreground="#606688" FontSize="11" FontWeight="Black" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,16" MaxLength="30" />

                <TextBlock Text="D E S C R I P C I Ó N" Foreground="#606688" FontSize="11" FontWeight="Black" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSubtitle" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,16" MaxLength="50" />

                <TextBlock Text="I M A G E N  D E  P O R T A D A" Foreground="#606688" FontSize="11" FontWeight="Black" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="60" Height="60" Background="#101224" CornerRadius="8" BorderBrush="#2E3458" BorderThickness="1" Margin="0,0,12,0">
                        <Image x:Name="ImgPreview" Stretch="UniformToFill" Margin="2">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,54,54" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    
                    <Button Grid.Column="1" Content="📁 Seleccionar Imagen..." Click="OnSelectImageClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="12,8"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="❌ Cancelar" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Grid.Column="2" Content="💾 Guardar" Click="OnSaveClick" Style="{StaticResource NeonButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
