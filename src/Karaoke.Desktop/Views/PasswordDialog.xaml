<Window x:Class="Karaoke.Desktop.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seguridad - Karaoke Comercial Pro" Height="260" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#181824">
    <Border BorderBrush="#00FFFF" BorderThickness="1" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔒 ACCESO RESTRINGIDO" FontSize="18" FontWeight="Black" Foreground="#00FFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Ingresa la contraseña de administrador para cambiar el fondo:" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>

            <PasswordBox x:Name="TxtPassword" FontSize="16" Padding="6" Background="#242436" Foreground="White" BorderBrush="#33334D"/>

            <TextBlock x:Name="LblError" Text="" FontSize="12" FontWeight="Bold" Foreground="#FF4444" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Aceptar" Click="OnAcceptClicked" IsDefault="True" Width="120" Height="36" Background="#00CCCC" Foreground="#121218" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand"/>
                <Button Content="Cancelar" Click="OnCancelClicked" IsCancel="True" Width="100" Height="36" Background="#33334D" Foreground="White" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
