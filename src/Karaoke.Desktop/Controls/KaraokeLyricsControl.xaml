<UserControl x:Class="Karaoke.Desktop.Controls.KaraokeLyricsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Base Text (Unsung lyrics in Pure White with heavy black drop shadow for contrast) -->
        <TextBlock x:Name="BaseText"
                   Text="Letra de Karaoke Sincronizada"
                   FontSize="68"
                   FontWeight="ExtraBold"
                   Foreground="#FFFFFF"
                   TextWrapping="NoWrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="5" Opacity="1.0"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Highlight Text (Sung lyrics in Neon Gold/Yellow with glowing effect, wiped via Clip) -->
        <TextBlock x:Name="HighlightText"
                   Text="Letra de Karaoke Sincronizada"
                   FontSize="68"
                   FontWeight="ExtraBold"
                   Foreground="#FFD700"
                   TextWrapping="NoWrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FF8C00" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</UserControl>
